{
  "name": "entourage-pro-backend",
  "version": "2.32.0",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "NODE_OPTIONS=--max-old-space-size=1024 nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "api:start": "node dist/main",
    "api:start:debug": "nest start --debug --watch",
    "api:dev": "nest start --watch",
    "api:dev:docker": "docker compose up",
    "api:dev:docker:build": "docker compose up --build",
    "worker:start": "node dist/worker",
    "worker:dev:docker": "docker compose -f docker-compose.yml -f docker-compose.worker.yml up",
    "worker:dev": "nest start --config nest-cli.worker.json --watch",
    "worker:dev:debug": "nest start --config nest-cli.worker.json --debug --watch",
    "all:dev:docker": "docker compose -f docker-compose.yml -f docker-compose.worker.yml up",
    "all:dev:docker:build": "docker compose -f docker-compose.yml -f docker-compose.worker.yml up --build",
    "test:e2e:docker": "docker compose -f docker-compose.test.yml run --rm api-test",
    "test": "run-s test:*",
    "test:ts-check": "tsc -p tsconfig.json --noEmit",
    "test:eslint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix --max-warnings=0",
    "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand --forceExit --verbose",
    "db:create": "sequelize db:create",
    "db:drop": "sequelize db:drop",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:seed": "sequelize db:seed:all",
    "db:dump": "./dump-db-schema.sh",
    "script:migrate-external-cvs": "node dist/scripts/migrate-external-cvs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-cloudfront": "^3.142.0",
    "@aws-sdk/client-s3": "^3.142.0",
    "@aws-sdk/lib-storage": "^3.180.0",
    "@aws-sdk/s3-request-presigner": "^3.142.0",
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@bull-board/nestjs": "^8.1.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@short.io/client-node": "^3.3.1",
    "@slack/bolt": "^3.19.0",
    "@types/express": "^4.17.13",
    "@types/multer": "^1.4.12",
    "@vonage/messages": "^1.24.0",
    "@vonage/server-sdk": "^3.27.0",
    "axios": "^1.18.1",
    "bullmq": "^5.70.4",
    "check-password-strength": "^2.0.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dd-trace": "^5.76.0",
    "deep-diff": "^1.0.2",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^16.0.1",
    "express-basic-auth": "^1.2.1",
    "ioredis": "^5.6.1",
    "jsforce": "^1.11.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "multer": "1.4.5-lts.2",
    "node-mailjet": "^6.0.4",
    "openai": "^6.45.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.8.0",
    "pg-hstore": "^2.3.4",
    "phone": "^3.1.23",
    "pusher": "^5.1.1-beta",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.29.0",
    "sequelize-cli": "^6.4.1",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.32.6",
    "uuid": "^8.3.2",
    "validator": "^13.7.0",
    "voyageai": "^0.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.0.0",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/deep-diff": "^1.0.1",
    "@types/diff-match-patch": "^1.0.32",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsforce": "^1.9.43",
    "@types/lodash": "^4.14.180",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^3.0.6",
    "@types/passport-local": "^1.0.34",
    "@types/sequelize": "^4.28.11",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^8.3.4",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.0.0",
    "husky": "^8.0.1",
    "jest": "^30.4.2",
    "lint-staged": "^13.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "supertest": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.0"
  },
  "packageManager": "pnpm@11.15.0"
}
